\fancyhead[L]{ File <%= idx %> of <%= count %>  }
\fancyhead[R]{ <%= lesc name %>  }

<% if file_type == 'image' %>
\includegraphics[width=\textwidth]{<%= latex_file_name %>}
<% end %>

<%
  if file_type == 'code'
    if (File.extname(file_name)[1..-1]) != 'ipynb'
%>
\inputminted[breaklines,linenos,breakanywhere,tabsize=4]{<%= Task.pygments_lang(File.extname(file_name)[1..-1]) %>}{<%= latex_file_name %>}
<%  else %>
\jupynotex{<%= latex_file_name %>}
<%
    end
  end
%>

<% if file_type == 'document'
    max_pages = [100, FileHelper.pages_in_pdf(latex_host_path(latex_file_name))].min

    for page_idx in 1..max_pages do %>
\includepdf[pages={<%= page_idx %>-<%= page_idx %>},fitpaper]{<%= latex_file_name %>}
    <% end # end for  %>

<% end %>

<% if %w[zip archive].include?(file_type) %>
\begin{tcolorbox}[colback=blue!5!white,colframe=blue!75!black]
  This zip file was uploaded with the portfolio. Zip contents are not expanded into this PDF.
\end{tcolorbox}
<% end %>
