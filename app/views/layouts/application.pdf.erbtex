<%
@latex_config = {
  :supporting => [
    Rails.root.join('app', 'views', 'layouts', 'jupynotex.py'),
    Rails.root.join('lib', 'shell', 'latex_run.sh')
  ],
  :recipe => [
    { :command => './latex_run.sh', :runs => 1 }
  ],
  :preservework => false,
  :workdir => -> { @work_id }
}
%>

\DocumentMetadata{uncompress}
\documentclass[11pt,a4paper]{article}
\usepackage[T1]{fontenc}
\usepackage{textcomp}
\usepackage{shellesc}
\usepackage{fontawesome}
\usepackage{tcolorbox}
\tcbuselibrary{breakable}
\tcbuselibrary{skins}

\newcommand{\jupynotex}[2][-]{
    \input|"python3 jupynotex.py '#2' '#1' '95'"
}

\usepackage[fencedCode,hashEnumerators,pipeTables,texMathDollars]{markdown}
\markdownSetup{rendererPrototypes={
  ulBeginTight={\begin{itemize}},
  ulEndTight={\end{itemize}},
  olBeginTight={\begin{enumerate}},
  olEndTight={\end{enumerate}}
}}

\usepackage{luatextra}
\defaultfontfeatures{Ligatures=TeX}

\usepackage{minted}
\usepackage{graphicx}
\usepackage[margin=2.0cm]{geometry}
\usepackage{fancyhdr}
\usepackage{pdfpages}
\usepackage{epstopdf}
\usepackage{amssymb}
% Notebook Markdown may use these comparison commands in inline maths.
\providecommand{\lt}{\mathrel{<}}
\providecommand{\gt}{\mathrel{>}}
\usepackage{colortbl}
\usepackage{lastpage}
\usepackage{multirow}
\usepackage[colorlinks]{hyperref}
\usepackage{longtable}
\hypersetup{colorlinks,
  linkcolor=black,
  filecolor=black,
  urlcolor=blue,
  citecolor=black}
<%
if @include_pax
%>
\usepackage{newpax}
\newpaxsetup{usefileattributes=true, addannots=true}
\directlua{require("newpax")}
<%= yield :preamble_newpax %>
<%
end
%>
\epstopdfDeclareGraphicsRule{.tif}{png}{.png}{convert #1 \OutputFile}
\AppendGraphicsExtensions{.tif}
\epstopdfDeclareGraphicsRule{.tiff}{png}{.png}{convert #1 \OutputFile}
\AppendGraphicsExtensions{.tiff}
\epstopdfDeclareGraphicsRule{.gif}{png}{.png}{convert -delete 1--1 #1 \OutputFile}
\AppendGraphicsExtensions{.gif}
\epstopdfDeclareGraphicsRule{.bmp}{png}{.png}{convert #1 \OutputFile}
\AppendGraphicsExtensions{.bmp}

\newcommand{\HRule}{\rule{\linewidth}{0.5mm}} % Defines a new command for the horizontal lines, change thickness here

\graphicspath{ {<%= @image_path %>/} }

\newcolumntype{P}[1]{>{\raggedright\arraybackslash}p{#1}}

\fancypagestyle{title}{%
    \renewcommand{\headrulewidth}{0pt}
    \fancyhead[L]{}
    \fancyhead[R]{}
    \fancyfoot[C]
    {
        \footnotesize Produced by <%= @doubtfire_product_name %>
    }
    \fancyfoot[R]{}
    \fancyfoot[L]{}
}

\fancypagestyle{body}{%
    \renewcommand{\headrulewidth}{0.4pt}
    \renewcommand{\footrulewidth}{0.4pt}
    \fancyhead{}
    \fancyfoot[C]
    {
      \footnotesize Page {\thepage} of \pageref{LastPage}
    }
    \fancyfoot[R]{}
}

\definecolor{complete}{HTML}{5BB75B}
\definecolor{rff}{HTML}{0079D8}

\definecolor{notstarted}{HTML}{CCCCCC}
\definecolor{workingonit}{HTML}{EB8F06}
\definecolor{needhelp}{HTML}{A48FCE}
\definecolor{fix}{HTML}{F2D85C}
\definecolor{dnr}{HTML}{D46B54}
\definecolor{redo}{HTML}{804000}
\definecolor{discuss}{HTML}{31B0D5}
\definecolor{rediscuss}{HTML}{126352}
\definecolor{demo}{HTML}{428BCA}
\definecolor{fail}{HTML}{D93713}
\definecolor{timeexceeded}{HTML}{D93713}
\definecolor{assessinportfolio}{HTML}{F2D85C}
\definecolor{attentionrequired}{HTML}{F1814D}

\begin{document}

<%= yield %>

\end{document}
