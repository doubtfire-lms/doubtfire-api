<%
def latex_color_for_status(task)
  if task.nil?
    'notstarted'
  else
    case task.status
    when :complete            then 'complete'
    when :not_started         then 'notstarted'
    when :fix_and_resubmit    then 'fix'
    when :time_exceeded       then 'timeexceeded'
    when :feedback_exceeded   then 'dnr'
    when :redo                then 'redo'
    when :need_help           then 'needhelp'
    when :working_on_it       then 'workingonit'
    when :discuss             then 'discuss'
    when :ready_for_feedback  then 'rff'
    when :demonstrate         then 'demo'
    when :fail                then 'fail'
    when :assess_in_portfolio then 'assessinportfolio'
    end
  end
end

def task_for_def_id(id)
  @project.tasks.where(task_definition_id: id).first
end

def task_for_def(td)
  task_for_def_id(td.id)
end

# array to hold the list of PDF paths we are inserting for annotation extraction with newpax
document_list = Array.new
%>

\begin{titlepage}
<% if @learning_summary_report
    # add learning summary report to the document list for annotation extraction
    document_list.append(@learning_summary_report) unless @is_retry %>
\includepdf[addtotoc={\thepage,section,1,Learning Summary Report,chap:learningsummary},pages={1-1},fitpaper]{<%= @learning_summary_report %>}
<%
    if FileHelper.pages_in_pdf(@learning_summary_report) > 30
%>
\includepdf[pages={2-},fitpaper]{<%= @learning_summary_report %>}
<%  else
      for page_idx in 2..FileHelper.pages_in_pdf(@learning_summary_report) do %>
\includepdf[pages={<%= page_idx %>-<%= page_idx %>},fitpaper]{<%= @learning_summary_report %>}
<%    end # end for
    end # if long LSR
  end # if there is a learning summary
%>

  \thispagestyle{title}
  \center

%----------------------------------------------------------------------------------------
%   HEADING SECTIONS
%----------------------------------------------------------------------------------------

  \textsc{\LARGE <%= lesc @institution_name  %>}     \\[1.5cm]
  \textsc{\Large <%= lesc @project.unit.name %>}     \\[0.5cm]
  \textsc{\large <%= lesc @student.first_name %>     \textsc{<%= lesc @student.last_name %>}}\\[0.5cm]

%----------------------------------------------------------------------------------------
%   TITLE SECTION
%----------------------------------------------------------------------------------------

  \HRule \\[0.4cm]
  { \huge \bfseries Portfolio Submission}\\[0.4cm] % Title of your document
  \HRule \\[1.5cm]

%----------------------------------------------------------------------------------------
%   AUTHOR SECTION
%----------------------------------------------------------------------------------------

\begin{minipage}{0.4\textwidth}
\begin{flushleft} \large
\emph{Submitted By:} \\
<%=   lesc @student.first_name %> \textsc{<%= lesc @student.last_name %>}\\
<%=   lesc @student.username %>\\
\end{flushleft}
\end{minipage}
~
\begin{minipage}{0.4\textwidth}
\begin{flushright} \large
\emph{Tutor:} \\
<%  unless @project.main_convenor_user.nil? %>
<%=   lesc @project.main_convenor_user.first_name %> \textsc{<%= lesc @project.main_convenor_user.last_name %>}
<%  else %>
No Tutor
<%  end %>
\end{flushright}
\end{minipage}\\[4cm]

%----------------------------------------------------------------------------------------
% DATE SECTION
%----------------------------------------------------------------------------------------

<% if @formatted_submission_date.present? %>
{\large <%= lesc @formatted_submission_date %>}\\[0.2cm]
{\large \textcolor{gray}{<%= lesc @formatted_submission_time %>}}\\[3cm]
<% else %>
\vspace{3cm}
<% end %>

%----------------------------------------------------------------------------------------
% LOGO SECTION
%----------------------------------------------------------------------------------------

\includegraphics[width=1cm]{apple-touch-icon-180x180.png}

\vfill

\end{titlepage}

\pagestyle{body}

\tableofcontents

\clearpage

% -----------------------------------------------------------------------------
% Overall task status details
% -----------------------------------------------------------------------------

\section{Overall Task Status}
\label{sec:Overall Task Status}

\begin{tabular}{p{8cm}|l|l}
  \textbf{Task} & \textbf{Status} & \textbf{Times Assessed} \\
  \hline
<% @task_defs.each do |td| %>
  <%= lesc td.name %> &
  <% task = task_for_def(td)
    if task.nil?
  %>
  \cellcolor{<%= latex_color_for_status(task) %>}<%= lesc 'Not Started' %> &  \\
  <% else %>
  \cellcolor{<%= latex_color_for_status(task) %>}<%= lesc task.task_status.name %> & <%= lesc task.times_assessed %> \\
  <% end %>
<% end %>
\end{tabular}


% -----------------------------------------------------------------------------
% Learning Outcomes
% -----------------------------------------------------------------------------

<%
  if @outcomes.count > 0
%>
\clearpage
\section{Learning Outcomes}
\label{sec:Learning Outcomes}
<%
    @outcomes.order(:abbreviation).each do | outcome |
%>

\subsection{<%= lesc outcome.abbreviation %> <%= lesc outcome.short_description %>}
\label{losub:<%= lesc outcome.id %>}

<%= lesc outcome.full_outcome_description %>
\medskip

<%
  linked_outcomes = outcome.demonstrated_through_outcomes
  if linked_outcomes.count > 0
%>
\begin{tabular}{p{9cm}|l|l}
  \textbf{Task} & \textbf{Status} & \textbf{Times Assessed}\\ \hline
<%
    # For each of the task definitions - linked to this learning outcome
    linked_outcomes.group_by(&:context_id).each do | task_definition_id, td_outcomes |
      next unless td_outcomes.first.context_type == 'TaskDefinition'

      # Output the task definition at the top
      task_definition = TaskDefinition.find(task_definition_id)
      task = task_for_def_id(task_definition_id)
%>
  <%= lesc task_definition.name %> &
  \cellcolor{<%= latex_color_for_status(task) %>}{<%= lesc (if task.nil? then 'Not Started' else task.task_status.name end) %>} &
  <%= lesc (if task.nil? then '' else task.times_assessed end) %> \\
<%
    end # outcome group
%>
\end{tabular}
\clearpage
<%
  end # each task definition
end # if there are linked outcomes
%>
\medskip
<%
  end # if there are outcomes

  if @files.count > 1
%>
% -----------------------------------------------------------------------------
% Additional Files
% -----------------------------------------------------------------------------

\clearpage
\section{Additional Files}

  \begin{enumerate}
    <% @files.each do |f| %>
      <% next if f[:idx] == 0 %>
      \item <%= lesc f[:name] %>
    <% end %>
  \end{enumerate}

  <% @files.each do |f| %>
    <% next if f[:idx] == 0 %>
    \clearpage

    \phantomsection
    \label{additional_file_<%= f[:idx] %>}
    \addcontentsline{toc}{subsection}{<%= lesc f[:name] %>}

    % add additional PDF files to the document list for annotation extraction
    <% if f[:kind] == "document" %>
         <% document_list.append(@project.portfolio_tmp_file_path(f)) unless @is_retry %>
    <% end %>

    <%= render partial:"shared/file", locals: {idx: f[:idx] - 1, count: @files.count - 1, name: f[:name], base_path: @base_path, file_name: @project.portfolio_tmp_file_path(f), file_type: f[:kind]} %>
  <% end %>
<% end %>

% -----------------------------------------------------------------------------
% Portfolio Task Pages
% -----------------------------------------------------------------------------

<%
@portfolio_tasks.each do |task|
%>
  \clearpage

  \section{<%= lesc task.task_definition.name %>}
  \label{sec_<%= lesc task.task_definition.id %>}

  <%= lesc task.task_definition.description %>
  \bigskip
  \\
<%
  if task.task_definition.learning_outcomes.count > 0
%>
    \begin{tabular}{p{3cm}|p{12cm}}
      \textbf{Outcome} & \textbf{Description}\\
      \hline
<%
    task.task_definition.learning_outcomes.each do | outcome |
%>
      <%= lesc outcome.abbreviation %> &
      <%= lesc outcome.full_outcome_description %> \\
<%
    end # if outcomes loop
%>
      \end{tabular}
      \bigskip
      \\
<%
  end # if outcomes exist
  if task.comments.count > 0
%>
    \begin{longtable}{p{3cm}|p{3cm}|p{9cm}}
      \textbf{Date} & \textbf{Author} & \textbf{Comment} \\ \hline
<%
    task.comments.each do |comment|
      full_text = comment.comment
      chunks = full_text.scan(/.{1,2000}/m) # split into 2000-char chunks
%>
    <% chunks.each_with_index do |chunk, i| %>
      <%= lesc comment.created_at.localtime.strftime("%Y/%m/%d %H:%M") %> & <%= lesc comment.user.name %> & <%if i > 0 %>\textit{\textcolor{gray}{[continued...]}}<% end %> <%= lesc chunk %> <% if i < chunks.size - 1 %> \textit{\textcolor{gray}{[comment has been split due to length]}}<% end %> \\
    <% end %>
<%
    end # comments loop
%>
    \end{longtable}
<%
  end # if comments exist

  if File.exist? task.final_pdf_path
    max_pages = FileHelper.pages_in_pdf(task.final_pdf_path)

    # Limit to 100 pages
    if max_pages > 100
      max_pages = 100
    else
      # add task evidence to the document list for annotation extraction
      # skip long files
      document_list.append(task.final_pdf_path) unless @is_retry
    end

    for page_idx in 1..max_pages do %>
\includepdf[pages={<%= page_idx %>-<%= page_idx %>},fitpaper]{<%= task.final_pdf_path %>}
<%  end # end for pages
  end # end if file exists
end # portfolio tasks do

# generate lua calls for newpax and insert it in the preamble for annotation extraction
content_for :preamble_newpax do %>
  \directlua
  {
  <% document_list.each do |path| %>
    % newpax does not allow the .pdf file extension, file paths must be supplied without extension
    newpax.writenewpax("<%= File.join(File.dirname(path), File.basename(path, File.extname(path))) %>")
  <% end %>
  }
<% end %>
