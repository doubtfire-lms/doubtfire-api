<!DOCTYPE html>
<html>
<head>
  <style type="text/css">
    .main {
      font-family: "Lucida Grande", "Helvetica Neue", Helvetica, Arial, sans-serif;
      color: #333;
      font-size: 14px;
      width: 100%;
      max-width: 800px;
      margin: 100px auto 0px auto;
      background-image: url('<%= @doubtfire_host %>/assets/images/logo.png');
      background-size: 3.5em;
      background-repeat: no-repeat;
      background-position: top 40px right 45px;
      padding: 30px 40px;
      border: solid 1px rgb(240, 240, 240);
      line-height: 200%;
      text-align: justify;
    }
    footer, .footer {
      font-family: "Lucida Grande", "Helvetica Neue", Helvetica, Arial, sans-serif;
      text-align: center;
      margin-top: 10px;
      color: #aaa;
      font-size: 0.7em;
    }
    .subtext {
      color: #aaa;
      font-size: 0.7em;
      margin-bottom: 10px;
      margin-top: -10px;
    }
    a, a:visited {
      color: #6a97d2;
      text-decoration: none;
    }
    a:hover {
      text-decoration: underline;
    }
    h1 {
      font-size: 1.1em;
    }
    h2 {
      font-size: 1em;
      margin: 25px 0 10px;
    }
    .notification-box {
      background: #fafafa;
      border-left: 4px solid #1565c0;
      margin: 20px 0;
      padding: 15px 20px;
    }
    .notification-box.warning {
      border-left-color: #ed6c02;
    }
    .notification-box.critical {
      border-left-color: #c62828;
    }
    .notification-box p {
      margin: 8px 0 0;
    }
    .notification-detail {
      margin-top: 2px;
    }
    .notification-time {
      color: #777;
      font-size: 0.75em;
      margin: 0 0 4px;
    }
  </style>
</head>
<body>
  <div class="main">
    <h1>Notification Summary</h1>

    <p>Hi <%= @recipient.first_name %>,</p>

    <p>
      You have <%= @notification_count %> new
      <%= 'notification'.pluralize(@notification_count) %> in <%= @doubtfire_product_name %>.
    </p>

    <% @units.each do |section| %>
      <h2><%= section[:unit].code %> - <%= section[:unit].name %></h2>

      <% section[:groups].each do |group| %>
        <div class="notification-box <%= group[:severity] %>">
          <% if group[:task] %>
            <strong><%= group[:task][:abbreviation] %> - <%= group[:task][:name] %></strong>
          <% elsif group[:project_id] %>
            <strong>Portfolio</strong>
          <% else %>
            <strong>Unit notification</strong>
          <% end %>
          <div class="notification-time"><%= notification_timestamp(group) %></div>
          <div class="notification-detail"><%= group[:detail] %></div>
          <% if group[:task] %>
            <p>
              <a href="<%= @doubtfire_host %>/projects/<%= group[:task][:project_id] %>/dashboard/<%= group[:task][:abbreviation] %><%= '?tutor=true' if group[:task][:staff_view] %>">
                View this task
              </a>
            </p>
          <% elsif group[:project_id] %>
            <p>
              <a href="<%= @doubtfire_host %>/projects/<%= group[:project_id] %>/portfolio">
                View your portfolio
              </a>
            </p>
          <% end %>
        </div>
      <% end %>
    <% end %>

    <p>
      <a href="<%= @notification_url %>">View all notifications and email settings</a>
    </p>

    <p>
      Cheers,<br />
      The <%= @doubtfire_product_name %> Team
    </p>
  </div>

  <footer class="footer">
    <a href="<%= @unsubscribe_url %>">Unsubscribe</a> | Generated with <%= @doubtfire_product_name %>
  </footer>
</body>
</html>
